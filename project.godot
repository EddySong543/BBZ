; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="波波攒"
config/version="0.1.0"
run/main_scene="res://src/ui/boot_screen.tscn"
config/features=PackedStringArray("4.7")
run/max_fps=60

[autoload]

BattleSetup="*res://src/battle/battle_setup.gd"
FontManager="*res://src/core/font_manager.gd"
TransitionManager="*res://src/core/transition_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/custom="res://assets/themes/default_theme.tres"

[rendering]

textures/canvas_textures/default_texture_filter=0
