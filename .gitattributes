# Force LF line endings for Godot source/scene/resource files.
# Prevents CRLF churn on Windows when other devs use macOS/Linux,
# and keeps git diffs clean regardless of core.autocrlf setting.

*.gd    text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf

# Markdown and config — also LF for consistency.
*.md    text eol=lf
*.json  text eol=lf
*.cfg   text eol=lf

# Shell scripts — LF 强制（CRLF 会破坏 shebang / git bash 解析·2026-07-03）。
*.sh    text eol=lf

# Binary assets — never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ogg   binary
*.wav   binary
*.mp3   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
