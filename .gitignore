# === Local Tooling (per-machine paths / proxy configs / launcher scripts) ===
# Never commit scripts containing local absolute paths, proxy IPs, or env-specific config.
*.bat
*.cmd
*.ps1.local

# === Asset Source Packs (kept locally, only curated files copied into assets/) ===
# Ark Pixel font full-language pack is 158 MB — only 2 TTFs are actually used (in assets/font/).
/font/

# === Local scratch & un-integrated sources (not shipped; keep out of git history) ===
# gitignore 不支持行内注释，pattern 必须单独成行。
# /ref/ = 参考图本地看；/res/ = 临时草稿(cloud.png)
# *.psd/*.docx = 美术/文档源文件
/ref/
/res/
# 外部导入资源统一暂存区（assets/import）：内容不入库·仅保留 README 说明约定
/assets/import/*
!/assets/import/README.md
# GPT 出图原图源档（assets/art_src）：大图不入库·仅保留 README 与 .gdignore（成品在 assets/ui·同 import 规）
/assets/art_src/*
!/assets/art_src/README.md
!/assets/art_src/.gdignore
*.psd
*.docx

# === Godot Plugins / Addons ===
# GUT (Godot Unit Test) 9.6.0 已入库锁版本（2026-07-17 审计修复④）：project.godot 默认
# 启用该插件，此前整目录被忽略 = 新克隆跑不了测试、也没有版本锁定。测试框架随仓库走。

# === Local sim / tooling scratch outputs (per-run, regenerated; never shipped) ===
# run_sim.gd 写出的临时平衡/烟雾测试目录（out_btest / out_smoke14 / out_upgrade_ab / out_planab …）。
/tools/sim/out_*/

