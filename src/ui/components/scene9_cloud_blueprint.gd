static func source_rgba() -> PackedByteArray:
	var compressed := Marshalls.base64_to_raw(SOURCE_RGBA_DEFLATE_BASE64)
	var raw := compressed.decompress(
			SOURCE_RGBA_BYTE_COUNT, FileAccess.COMPRESSION_DEFLATE)
	assert(raw.size() == SOURCE_RGBA_BYTE_COUNT)
	var hashing := HashingContext.new()
	hashing.start(HashingContext.HASH_SHA256)
	hashing.update(raw)
	assert(hashing.finish().hex_encode() == SOURCE_RGBA_SHA256)
	return raw
