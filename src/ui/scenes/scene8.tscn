[node name="Scene8" type="Control" unique_id=1051971769]
editor_description = "Scene8 天光镜湖。极光静态像素轮廓与慢速动态保持不变；远山以同源错位、翻转和低对比三层轮廓补出空气纵深，中央 snow 作为近景下沿接入，湖面、冰、水线和既有手调构图保持不变。"
texture_filter = 1
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_stage")

